# Canonical SkillCommand JSON (action, objects, parameters, command).
string skill_command_json
# True replays the recording as-is even when the risk-aware server could branch.
bool plain_replay
---
# ROS action status carries succeeded/canceled/aborted; this explains it.
string message
# Parts that reached the end of trajectory playback, in execution order.
string[] completed_parts
---
string phase
# One-based while a part is active; zero during task-level phases.
uint32 part_index
uint32 part_count
string skill_name
float32 part_progress
