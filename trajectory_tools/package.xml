<?xml version="1.0"?>
<package format="3">
  <name>trajectory_tools</name>
  <version>1.0.0</version>
  <description>Code that reads trajectory_data: skill names, viewers, npz-to-video. Kept apart so trajectory_data holds data only.</description>
  <maintainer email="petr.vanc@cvut.cz">petrvanc</maintainer>
  <license>MIT</license>
  <exec_depend>trajectory_data</exec_depend>
  <!-- skill_visualizer also imports object_localization (cfg path only). Not
       declared: object_localization -> skills_manager -> trajectory_tools
       would close a dependency cycle. -->
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
